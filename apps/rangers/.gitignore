# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
.playwright-mcp/

# supabase CLI ローカル状態キャッシュ（supabase link/db等の実行時に自動生成される。
# 接続文字列等が含まれるため追跡しない）
supabase/.temp/

# docs: 画像・平文パスワード入りファイルはローカルのみに留める（Markdownドキュメントは追跡する）
docs/reference/
docs/test-guide.md
